# OBJ file format with minimal cube example

# Vertices (x, y, z)
v 0.0 0.0 0.0
v 1.0 0.0 0.0
v 1.0 1.0 0.0
v 0.0 1.0 0.0
v 0.0 0.0 1.0
v 1.0 0.0 1.0
v 1.0 1.0 1.0
v 0.0 1.0 1.0

# Texture coordinates (u, v) - optional
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals (x, y, z) - optional
vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 1.0 0.0

# Faces (vertex/texture/normal)
f 1/1/5 2/2/5 3/3/5 4/4/5  # Bottom face
f 5/4/6 8/3/6 7/2/6 6/1/6  # Top face
f 1/1/3 5/4/3 6/2/3 2/1/3  # Front face
f 2/2/4 6/3/4 7/4/4 3/3/4  # Back face
f 3/3/2 7/4/2 8/1/2 4/2/2  # Right face
f 5/4/1 1/1/1 4/2/1 8/3/1  # Left face