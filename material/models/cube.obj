# Cube White Model (Without texture)

# Vertices (x, y, z)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Normals (x, y, z)
vn  0.0  0.0 -1.0  # Back face
vn  0.0  0.0  1.0  # Front face
vn -1.0  0.0  0.0  # Left face
vn  1.0  0.0  0.0  # Right face
vn  0.0 -1.0  0.0  # Bottom face
vn  0.0  1.0  0.0  # Top face

# Texture coordinates (u, v) - Optional, here we assume a basic square texture
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Faces (vertex/texture/normal)
f 1/1/1 2/2/1 3/3/1 4/4/1  # Back face
f 5/1/2 6/2/2 7/3/2 8/4/2  # Front face
f 1/1/3 2/2/3 6/3/3 5/4/3  # Left face
f 2/1/4 3/2/4 7/3/4 6/4/4  # Right face
f 4/1/5 1/2/5 5/3/5 8/4/5  # Bottom face
f 3/1/6 4/2/6 8/3/6 7/4/6  # Top face
